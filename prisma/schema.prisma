generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()"))
  email              String              @unique
  username           String?             @unique
  passwordHash       String?             @map("password_hash")
  clerkUserId        String?             @unique @map("clerk_user_id")
  authProvider       String              @default("local") @map("auth_provider")
  role               String              @default("student")
  name               String?
  phone              String?
  avatar             String?
  isActive           Boolean             @default(true) @map("is_active")
  lastLogin          DateTime?           @map("last_login")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  chatMessages       ChatMessage[]
  notifications      Notification[]
  parent             Parent?
  student            Student?
  teacher            Teacher?
  webrtcParticipants WebrtcParticipant[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

model Student {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  userId          String           @unique @map("user_id")
  gradeLevel      String?          @map("grade_level")
  stream          String?
  coins           Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  attendances     Attendance[]
  bookPurchases   BookPurchase[]
  chatSessions    ChatSession[]
  enrollments     Enrollment[]
  examAttempts    ExamAttempt[]
  grades          Grade[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  weaknessReports WeaknessReport[]

  @@index([userId])
  @@map("students")
}

model Teacher {
  id          String       @id @default(dbgenerated("gen_random_uuid()"))
  userId      String       @unique @map("user_id")
  bio         String?
  expertise   String?
  specialties String[]
  verified    Boolean      @default(false)
  ratingAvg   Decimal?     @default(0) @map("rating_avg") @db.Decimal(3, 2)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  books       Book[]
  courses     Course[]
  exams       Exam[]
  meetings    Meeting[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  webrtcRooms WebrtcRoom[]

  @@index([userId])
  @@map("teachers")
}

model Parent {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("parents")
}

model Course {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  teacherId       String           @map("teacher_id")
  title           String
  description     String?
  thumbnail       String?
  price           Float            @default(0)
  isPublished     Boolean          @default(false) @map("is_published")
  isCompetitive   Boolean          @default(false) @map("is_competitive")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  exams           Exam[]
  lessons         Lesson[]
  weaknessReports WeaknessReport[]
  webrtcRooms     WebrtcRoom[]

  @@index([teacherId])
  @@map("courses")
}

model Lesson {
  id           String       @id @default(dbgenerated("gen_random_uuid()"))
  courseId     String       @map("course_id")
  title        String
  content      String?
  summary      String?
  videoUrl     String?      @map("video_url")
  videoFileRef String?      @map("video_file_ref")
  pdfFileRef   String?      @map("pdf_file_ref")
  order        Int
  orderIndex   Int?         @map("order_index")
  isPublished  Boolean      @default(false) @map("is_published")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  attendances  Attendance[]
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([courseId, order])
  @@map("lessons")
}

model Enrollment {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  studentId  String   @map("student_id")
  courseId   String   @map("course_id")
  progress   Int      @default(0)
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

model Exam {
  id              String        @id @default(dbgenerated("gen_random_uuid()"))
  courseId        String        @map("course_id")
  teacherId       String        @map("teacher_id")
  title           String
  description     String?
  duration        Int
  durationMinutes Int?          @map("duration_minutes")
  totalMarks      Int           @map("total_marks")
  passingMarks    Int           @map("passing_marks")
  availableFrom   DateTime?     @map("available_from")
  availableTo     DateTime?     @map("available_to")
  proctored       Boolean       @default(false)
  isPublished     Boolean       @default(false) @map("is_published")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  attempts        ExamAttempt[]
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher         Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grades          Grade[]
  questions       Question[]

  @@index([courseId])
  @@index([teacherId])
  @@index([availableFrom, availableTo])
  @@map("exams")
}

model Question {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  examId        String   @map("exam_id")
  type          String
  questionText  String   @map("question_text")
  body          String?
  qtype         String?
  options       Json?
  correctAnswer String?  @map("correct_answer")
  marks         Int
  points        Int?     @default(1)
  order         Int
  createdAt     DateTime @default(now()) @map("created_at")
  optionsList   Option[]
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("questions")
}

model Option {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  questionId String   @map("question_id")
  optionText String   @map("option_text")
  isCorrect  Boolean  @default(false) @map("is_correct")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("options")
}

model ExamAttempt {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  examId      String    @map("exam_id")
  studentId   String    @map("student_id")
  answers     Json
  score       Float?
  isPassed    Boolean?  @map("is_passed")
  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  finishedAt  DateTime? @map("finished_at")
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([studentId])
  @@index([startedAt])
  @@map("exam_attempts")
}

model Grade {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  studentId   String   @map("student_id")
  examId      String   @map("exam_id")
  score       Int?
  gradeLetter String?  @map("grade_letter")
  gradedAt    DateTime @default(now()) @map("graded_at")
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([examId])
  @@map("grades")
}

model Attendance {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  studentId  String   @map("student_id")
  lessonId   String   @map("lesson_id")
  attendDate DateTime @map("attend_date") @db.Date
  present    Boolean  @default(false)
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId, attendDate])
  @@index([studentId])
  @@index([lessonId])
  @@index([attendDate])
  @@map("attendance")
}

model Meeting {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  meetingLink   String?   @map("meeting_link")
  hostTeacherId String    @map("host_teacher_id")
  startTime     DateTime? @map("start_time")
  endTime       DateTime? @map("end_time")
  description   String?
  hostTeacher   Teacher   @relation(fields: [hostTeacherId], references: [id], onDelete: Cascade)

  @@index([hostTeacherId])
  @@index([startTime])
  @@map("meetings")
}

model WebrtcRoom {
  id           String              @id @default(dbgenerated("gen_random_uuid()"))
  roomName     String              @unique @map("room_name")
  courseId     String?             @map("course_id")
  hostId       String              @map("host_id")
  roomType     String              @map("room_type")
  isActive     Boolean             @default(true) @map("is_active")
  maxCapacity  Int?                @map("max_capacity")
  createdAt    DateTime            @default(now()) @map("created_at")
  startedAt    DateTime?           @map("started_at")
  endedAt      DateTime?           @map("ended_at")
  participants WebrtcParticipant[]
  recordings   WebrtcRecording[]
  course       Course?             @relation(fields: [courseId], references: [id])
  host         Teacher             @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([roomName])
  @@index([courseId])
  @@index([hostId])
  @@index([isActive])
  @@map("webrtc_rooms")
}

model WebrtcParticipant {
  id           String     @id @default(dbgenerated("gen_random_uuid()"))
  roomId       String     @map("room_id")
  userId       String     @map("user_id")
  peerId       String?    @map("peer_id")
  role         String
  joinedAt     DateTime   @default(now()) @map("joined_at")
  leftAt       DateTime?  @map("left_at")
  isConnected  Boolean    @default(true) @map("is_connected")
  audioEnabled Boolean    @default(true) @map("audio_enabled")
  videoEnabled Boolean    @default(true) @map("video_enabled")
  screenShare  Boolean    @default(false) @map("screen_share")
  room         WebrtcRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([roomId, isConnected])
  @@map("webrtc_participants")
}

model WebrtcRecording {
  id            String     @id @default(dbgenerated("gen_random_uuid()"))
  roomId        String     @map("room_id")
  fileName      String     @map("file_name")
  fileSize      BigInt?    @map("file_size")
  duration      Int?
  storageUrl    String?    @map("storage_url")
  thumbnailUrl  String?    @map("thumbnail_url")
  recordingType String     @default("video") @map("recording_type")
  startedAt     DateTime   @default(now()) @map("started_at")
  endedAt       DateTime?  @map("ended_at")
  isProcessed   Boolean    @default(false) @map("is_processed")
  room          WebrtcRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([startedAt])
  @@index([isProcessed])
  @@map("webrtc_recordings")
}

model ChatSession {
  id          String        @id @default(dbgenerated("gen_random_uuid()"))
  studentId   String        @map("student_id")
  sessionType String        @map("session_type")
  lastActive  DateTime?     @map("last_active")
  messages    ChatMessage[]
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("chat_sessions")
}

model ChatMessage {
  id           String      @id @default(dbgenerated("gen_random_uuid()"))
  sessionId    String      @map("session_id")
  senderUserId String      @map("sender_user_id")
  message      String?
  sentAt       DateTime    @default(now()) @map("sent_at")
  sender       User        @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([senderUserId])
  @@index([sentAt])
  @@map("chat_messages")
}

model WeaknessReport {
  id                 String   @id @default(dbgenerated("gen_random_uuid()"))
  studentId          String   @map("student_id")
  courseId           String   @map("course_id")
  topic              String?
  severityScore      Decimal? @map("severity_score") @db.Decimal
  recommendedActions String?  @map("recommended_actions")
  createdAt          DateTime @default(now()) @map("created_at")
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([severityScore(sort: Desc)])
  @@map("weakness_reports")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String   @map("user_id")
  type      String   @default("general")
  title     String
  body      String?
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Book {
  id          String         @id @default(dbgenerated("gen_random_uuid()"))
  teacherId   String         @map("teacher_id")
  title       String
  description String?
  subject     String
  grade       String
  price       Float          @default(0)
  coverImage  String?        @map("cover_image")
  isPublished Boolean        @default(false) @map("is_published")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  teacher     Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  purchases   BookPurchase[]

  @@index([teacherId])
  @@index([subject])
  @@index([grade])
  @@map("books")
}

model BookPurchase {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  bookId    String   @map("book_id")
  studentId String   @map("student_id")
  paidAt    DateTime @default(now()) @map("paid_at")
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([bookId, studentId])
  @@index([bookId])
  @@index([studentId])
  @@map("book_purchases")
}
