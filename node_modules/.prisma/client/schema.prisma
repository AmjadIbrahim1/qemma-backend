// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Management
// ============================================

model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  name         String?
  phone        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)

  // Relations
  student            Student?
  teacher            Teacher?
  parent             Parent?
  chatMessages       ChatMessage[]
  webrtcParticipants WebrtcParticipant[]

  @@map("users")
}

enum UserRole {
  student
  teacher
  parent
  admin
}

// ============================================
// Student Profile
// ============================================

model Student {
  id         String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String  @unique @map("user_id") @db.Uuid
  gradeLevel String? @map("grade_level")
  stream     Stream?
  coins      Int     @default(0)

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  examAttempts    ExamAttempt[]
  grades          Grade[]
  attendances     Attendance[]
  chatSessions    ChatSession[]
  weaknessReports WeaknessReport[]

  @@map("students")
}

enum Stream {
  sci_math
  sci_bio
  arts
}

// ============================================
// Teacher Profile
// ============================================

model Teacher {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  bio         String?
  specialties String[]
  ratingAvg   Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses     Course[]
  meetings    Meeting[]
  webrtcRooms WebrtcRoom[]

  @@map("teachers")
}

// ============================================
// Parent Profile
// ============================================

model Parent {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parents")
}

// ============================================
// Course Management
// ============================================

model Course {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title         String
  description   String?
  teacherId     String?  @map("teacher_id") @db.Uuid
  isCompetitive Boolean  @default(false) @map("is_competitive")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  teacher         Teacher?         @relation(fields: [teacherId], references: [id])
  lessons         Lesson[]
  exams           Exam[]
  enrollments     Enrollment[]
  weaknessReports WeaknessReport[]
  webrtcRooms     WebrtcRoom[]

  @@map("courses")
}

model Lesson {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  courseId     String  @map("course_id") @db.Uuid
  title        String?
  summary      String?
  videoFileRef String? @map("video_file_ref") @db.Uuid
  pdfFileRef   String? @map("pdf_file_ref") @db.Uuid
  orderIndex   Int?    @map("order_index")

  // Relations
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@map("lessons")
}

model Enrollment {
  studentId  String   @map("student_id") @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@id([studentId, courseId])
  @@map("enrollments")
}

// ============================================
// Exam Management
// ============================================

model Exam {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  title           String?
  availableFrom   DateTime? @map("available_from") @db.Timestamptz(6)
  availableTo     DateTime? @map("available_to") @db.Timestamptz(6)
  durationMinutes Int?      @map("duration_minutes")
  proctored       Boolean   @default(false)

  // Relations
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  examAttempts ExamAttempt[]
  grades       Grade[]

  @@map("exams")
}

model Question {
  id     String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  examId String  @map("exam_id") @db.Uuid
  body   String?
  qtype  String?
  points Int     @default(1)

  // Relations
  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  options Option[]

  @@map("questions")
}

model Option {
  id         String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  optionText String? @map("option_text")
  isCorrect  Boolean @default(false) @map("is_correct")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model ExamAttempt {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  examId     String    @map("exam_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  score      Int?
  answers    Json?

  // Relations
  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@map("exam_attempts")
}

model Grade {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  score       Int?
  gradeLetter String?  @map("grade_letter")
  gradedAt    DateTime @default(now()) @map("graded_at") @db.Timestamptz(6)

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  exam    Exam    @relation(fields: [examId], references: [id])

  @@map("grades")
}

// ============================================
// Attendance
// ============================================

model Attendance {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  attendDate DateTime @map("attend_date") @db.Date
  present    Boolean  @default(false)

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  lesson  Lesson  @relation(fields: [lessonId], references: [id])

  @@map("attendance")
}

// ============================================
// Meetings
// ============================================

model Meeting {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  meetingLink   String?   @map("meeting_link")
  hostTeacherId String    @map("host_teacher_id") @db.Uuid
  startTime     DateTime? @map("start_time") @db.Timestamptz(6)
  endTime       DateTime? @map("end_time") @db.Timestamptz(6)
  description   String?

  // Relations
  hostTeacher Teacher @relation(fields: [hostTeacherId], references: [id])

  @@map("meetings")
}

// ============================================
// WebRTC System
// ============================================

model WebrtcRoom {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roomName    String         @unique @map("room_name")
  courseId    String?        @map("course_id") @db.Uuid
  hostId      String         @map("host_id") @db.Uuid
  roomType    WebrtcRoomType @map("room_type")
  isActive    Boolean        @default(true) @map("is_active")
  maxCapacity Int?           @map("max_capacity")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt   DateTime?      @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime?      @map("ended_at") @db.Timestamptz(6)

  // Relations
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  host         Teacher             @relation(fields: [hostId], references: [id])
  participants WebrtcParticipant[]
  recordings   WebrtcRecording[]

  @@index([roomName])
  @@index([isActive])
  @@map("webrtc_rooms")
}

enum WebrtcRoomType {
  live_class
  one_on_one
  group_study
  exam_proctoring
}

model WebrtcParticipant {
  id           String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roomId       String                @map("room_id") @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  peerId       String?               @map("peer_id")
  role         WebrtcParticipantRole
  joinedAt     DateTime              @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt       DateTime?             @map("left_at") @db.Timestamptz(6)
  isConnected  Boolean               @default(true) @map("is_connected")
  audioEnabled Boolean               @default(true) @map("audio_enabled")
  videoEnabled Boolean               @default(true) @map("video_enabled")
  screenShare  Boolean               @default(false) @map("screen_share")

  // Relations
  room WebrtcRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
  @@map("webrtc_participants")
}

enum WebrtcParticipantRole {
  host
  presenter
  participant
  observer
}

model WebrtcRecording {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roomId        String    @map("room_id") @db.Uuid
  fileName      String    @map("file_name")
  fileSize      BigInt?   @map("file_size")
  duration      Int?      @map("duration")
  storageUrl    String?   @map("storage_url")
  thumbnailUrl  String?   @map("thumbnail_url")
  recordingType String    @default("video") @map("recording_type")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  isProcessed   Boolean   @default(false) @map("is_processed")

  // Relations
  room WebrtcRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("webrtc_recordings")
}

// ============================================
// Chat System
// ============================================

model ChatSession {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId   String      @map("student_id") @db.Uuid
  sessionType SessionType @map("session_type")
  lastActive  DateTime?   @map("last_active") @db.Timestamptz(6)

  // Relations
  student  Student       @relation(fields: [studentId], references: [id])
  messages ChatMessage[]

  @@map("chat_sessions")
}

enum SessionType {
  chatbot
  teacher_chat
}

model ChatMessage {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  senderUserId String   @map("sender_user_id") @db.Uuid
  message      String?
  sentAt       DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id])
  sender  User        @relation(fields: [senderUserId], references: [id])

  @@map("chat_messages")
}

// ============================================
// AI Analysis & Reports
// ============================================

model WeaknessReport {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  courseId           String   @map("course_id") @db.Uuid
  topic              String?
  severityScore      Decimal? @map("severity_score") @db.Decimal
  recommendedActions String?  @map("recommended_actions")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@map("weakness_reports")
}
